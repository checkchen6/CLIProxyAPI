# Consumed by docker-compose.yml in this directory. Edit and re-run
# `docker compose up -d` to apply.
CLI_PROXY_IMAGE=registry.cn-hangzhou.aliyuncs.com/wgyc/cli-proxy-api
# latest 是默认值，跟随 build-push.ps1 推送的最新构建。
# 需要锁定某个具体构建时改成显式 tag，例如 v7.2.118。
CLI_PROXY_VERSION=latest
CLI_PROXY_BIND=127.0.0.1
CLI_PROXY_PORT=8317
TZ=Asia/Shanghai
