# Normalize line endings so shell scripts and container-side config files stay
# LF regardless of the contributor's core.autocrlf setting. CRLF in a script that
# runs inside a Linux container surfaces as "exec format error" or
# "bad interpreter: No such file or directory".
* text=auto eol=lf

*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf
# SVG is text despite living next to the image assets below.
*.svg text eol=lf

# Windows-only tooling keeps CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binary content.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
*.tar binary
